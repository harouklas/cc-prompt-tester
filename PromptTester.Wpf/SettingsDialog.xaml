<Window x:Class="PromptTester.Wpf.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Run settings"
        Width="700" Height="760"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="{StaticResource BrandBodyFont}"
        Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style x:Key="FolderPickerButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PickerBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PickerBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PickerBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="PickerBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemeToggleStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="74" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ToggleTrack"
                                Background="{DynamicResource BorderStrongBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16">
                            <Ellipse x:Name="ToggleThumb"
                                     Width="24" Height="24" Margin="3"
                                     HorizontalAlignment="Left"
                                     Fill="{DynamicResource TextBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ToggleThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="ToggleThumb" Property="Fill" Value="{DynamicResource OnAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                <Setter TargetName="ToggleTrack" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="2" Padding="28,25,28,24"
            Background="{DynamicResource BrandBlackBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1.5" CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="48" Height="48" Padding="6" Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="24">
                    <Image Source="Assets/prompt-tester-logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,1,0,0">
                    <TextBlock Text="Run settings" FontFamily="{StaticResource BrandDisplayFont}" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0" Text="Configure how Prompt Tester processes your documents." Style="{StaticResource HelperTextStyle}" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="0,22,0,18" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="PROFILE" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" />
                    <Label Margin="0,9,0,6" Content="Saved configuration" Style="{StaticResource FieldLabelStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ProfileComboBox" IsEditable="True" MinHeight="38" />
                        <Button Grid.Column="2" Content="Save" Style="{StaticResource CompactButtonStyle}" Click="SaveProfileButton_Click" />
                        <Button Grid.Column="4" Content="Load" Style="{StaticResource CompactButtonStyle}" Click="LoadProfileButton_Click" />
                        <Button Grid.Column="6" Content="Delete" Style="{StaticResource DangerButtonStyle}" MinHeight="38" Padding="11,5" Click="DeleteProfileButton_Click" />
                    </Grid>
                    <TextBlock Margin="0,5,0,0" Text="Profiles include the prompt, extraction fields, model, OpenAI level, detail, input folder, and report path." Style="{StaticResource HelperTextStyle}" />

                    <Border Height="1" Margin="0,18" Background="{DynamicResource BorderBrush}" />
                    <TextBlock Text="ACCESS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" />
                    <Label Margin="0,9,0,6" Content="OpenAI API key" Style="{StaticResource FieldLabelStyle}" />
                    <PasswordBox x:Name="ApiKeyPasswordBox" Height="38" MinHeight="38" Padding="10,5" />
                    <TextBlock Margin="0,5,0,0" Text="Kept in memory for this session only." Style="{StaticResource HelperTextStyle}" />

                    <Border Height="1" Margin="0,18" Background="{DynamicResource BorderBrush}" />
                    <TextBlock Text="MODEL" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" />
                    <Label Margin="0,9,0,6" Content="Model" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="ModelComboBox" SelectedValuePath="Id">
                        <ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Id}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <Label Margin="0,14,0,6" Content="OpenAI Level" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="OpenAiLevelComboBox" SelectedValuePath="Id">
                        <ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Margin="0,5,0,0" Text="Controls safe parallelism. Exact limits still depend on your organization, project, and selected model." Style="{StaticResource HelperTextStyle}" />
                    <Label Margin="0,14,0,6" Content="Visual detail" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="InputDetailComboBox" SelectedValuePath="Id">
                        <ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>

                    <Border Height="1" Margin="0,18" Background="{DynamicResource BorderBrush}" />
                    <TextBlock Text="APPEARANCE" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" />
                    <Label Margin="0,9,0,0" Content="Application theme" Style="{StaticResource FieldLabelStyle}" />
                    <StackPanel Width="92" Margin="0,8,0,0" HorizontalAlignment="Left">
                        <CheckBox x:Name="ThemeModeToggle"
                                  HorizontalAlignment="Center"
                                  Style="{StaticResource ThemeToggleStyle}"
                                  ToolTip="Switch between dark and light mode" />
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock HorizontalAlignment="Center" FontSize="17" Foreground="{DynamicResource MutedTextBrush}" Text="&#x263E;" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" FontSize="17" Foreground="{DynamicResource AccentTextBrush}" Text="&#x2600;" />
                        </Grid>
                    </StackPanel>
                    <TextBlock Margin="0,5,0,0" Text="Moon selects dark mode; sun selects light mode." Style="{StaticResource HelperTextStyle}" />

                    <Border Height="1" Margin="0,18" Background="{DynamicResource BorderBrush}" />
                    <TextBlock Text="FILES" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" />
                    <Label Margin="0,9,0,6" Content="Input folder" Style="{StaticResource FieldLabelStyle}" />
                    <Button Style="{StaticResource FolderPickerButtonStyle}"
                            ToolTip="{Binding Text, ElementName=InputFolderPathText}"
                            Click="InputFolderButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="InputFolderPathText" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentTextBrush}" Text="&#xE8B7;" />
                        </Grid>
                    </Button>
                    <TextBlock Margin="0,5,0,0" Text="Every folder of images is processed together as one document." Style="{StaticResource HelperTextStyle}" />
                    <Label Margin="0,14,0,6" Content="Output folder" Style="{StaticResource FieldLabelStyle}" />
                    <Button Style="{StaticResource FolderPickerButtonStyle}"
                            ToolTip="{Binding Text, ElementName=OutputFolderPathText}"
                            Click="OutputFolderButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="OutputFolderPathText" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource AccentTextBrush}" Text="&#xE8B7;" />
                        </Grid>
                    </Button>
                    <TextBlock Margin="0,5,0,0" Text="Prompt Tester creates a timestamped Excel report and its decision-log folder here." Style="{StaticResource HelperTextStyle}" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="105" Content="Cancel" Margin="0,0,9,0" Click="CancelButton_Click" />
                <Button MinWidth="135" Content="Save settings" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
