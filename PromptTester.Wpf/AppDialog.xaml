<Window x:Class="PromptTester.Wpf.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prompt Tester"
        Width="440"
        SizeToContent="Height"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="{StaticResource BrandBodyFont}"
        Foreground="{DynamicResource TextBrush}">
    <Border Margin="2"
            Padding="30,25,30,24"
            Background="{DynamicResource BrandBlackBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1.5"
            CornerRadius="18">
        <StackPanel HorizontalAlignment="Center">
            <Border Width="72"
                    Height="72"
                    Padding="5"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="36">
                <Image Source="Assets/prompt-tester-logo.png"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="Prompt Tester logo" />
            </Border>

            <TextBlock x:Name="DialogTitleTextBlock"
                       Margin="0,16,0,0"
                       HorizontalAlignment="Center"
                       FontFamily="{StaticResource BrandDisplayFont}"
                       FontSize="23"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="DialogMessageTextBlock"
                       Margin="0,10,0,0"
                       MaxWidth="360"
                       HorizontalAlignment="Center"
                       FontSize="13"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <StackPanel Margin="0,23,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                <Button x:Name="SecondaryButton"
                        MinWidth="105"
                        Margin="0,0,9,0"
                        Content="Cancel"
                        Click="SecondaryButton_Click" />
                <Button x:Name="PrimaryButton"
                        MinWidth="125"
                        Content="Continue"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="PrimaryButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
