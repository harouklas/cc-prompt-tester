<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Neutral developer-tool palette -->
    <Color x:Key="BrandBlackColor">#071018</Color>
    <Color x:Key="CanvasColor">#0A1118</Color>
    <Color x:Key="SurfaceColor">#101A24</Color>
    <Color x:Key="SurfaceRaisedColor">#172432</Color>
    <Color x:Key="SurfaceHoverColor">#203244</Color>
    <Color x:Key="AccentPrimaryColor">#16B8F3</Color>
    <Color x:Key="AccentHoverColor">#42C7F7</Color>
    <Color x:Key="AccentPressedColor">#0B8FC6</Color>
    <Color x:Key="AccentTextColor">#6FD8FF</Color>
    <Color x:Key="AccentSoftColor">#0B2430</Color>
    <Color x:Key="TextColor">#F4F8FB</Color>
    <Color x:Key="MutedTextColor">#B4C1CC</Color>
    <Color x:Key="SubtleTextColor">#8798A7</Color>
    <Color x:Key="BorderColor">#304354</Color>
    <Color x:Key="BorderStrongColor">#6B8192</Color>
    <Color x:Key="FocusColor">#6FD8FF</Color>

    <!-- Reusable application typography. -->
    <FontFamily x:Key="BrandBodyFont">Century Gothic, Segoe UI</FontFamily>
    <FontFamily x:Key="BrandDisplayFont">Cascadia Code, Consolas</FontFamily>

    <SolidColorBrush x:Key="BrandBlackBrush" Color="{StaticResource BrandBlackColor}" />
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentSelectionBrush" Color="#125D78" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="{StaticResource SubtleTextColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#263746" />

    <!-- Semantic colours remain distinct from the primary accent. -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#9BE15D" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#172510" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFD166" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#2D2510" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#806A25" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF7B88" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="#30151B" />
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#8F3944" />
</ResourceDictionary>
